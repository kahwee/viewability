{
  "name": "viewability",
  "version": "1.4.2",
  "description": "Measure how much of a DOM element is visible in the viewport",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/viewability.min.js",
  "jsdelivr": "./dist/viewability.min.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vertical": {
      "import": {
        "types": "./dist/vertical.d.ts",
        "default": "./dist/vertical.js"
      },
      "require": {
        "types": "./dist/vertical.d.cts",
        "default": "./dist/vertical.cjs"
      }
    },
    "./vertical.js": {
      "import": {
        "types": "./dist/vertical.d.ts",
        "default": "./dist/vertical.js"
      },
      "require": {
        "types": "./dist/vertical.d.cts",
        "default": "./dist/vertical.cjs"
      }
    },
    "./horizontal": {
      "import": {
        "types": "./dist/horizontal.d.ts",
        "default": "./dist/horizontal.js"
      },
      "require": {
        "types": "./dist/horizontal.d.cts",
        "default": "./dist/horizontal.cjs"
      }
    },
    "./horizontal.js": {
      "import": {
        "types": "./dist/horizontal.d.ts",
        "default": "./dist/horizontal.js"
      },
      "require": {
        "types": "./dist/horizontal.d.cts",
        "default": "./dist/horizontal.cjs"
      }
    },
    "./isElementOnScreen": {
      "import": {
        "types": "./dist/is-element-on-screen.d.ts",
        "default": "./dist/is-element-on-screen.js"
      },
      "require": {
        "types": "./dist/is-element-on-screen.d.cts",
        "default": "./dist/is-element-on-screen.cjs"
      }
    },
    "./isElementOnScreen.js": {
      "import": {
        "types": "./dist/is-element-on-screen.d.ts",
        "default": "./dist/is-element-on-screen.js"
      },
      "require": {
        "types": "./dist/is-element-on-screen.d.cts",
        "default": "./dist/is-element-on-screen.cjs"
      }
    },
    "./measure": {
      "import": {
        "types": "./dist/measure.d.ts",
        "default": "./dist/measure.js"
      },
      "require": {
        "types": "./dist/measure.d.cts",
        "default": "./dist/measure.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:modules && tsgo -p tsconfig.build.json && esbuild src/index.ts --bundle --minify --format=iife --global-name=viewability --outfile=dist/viewability.min.js && node scripts/create-cjs-wrappers.mjs",
    "build:modules": "esbuild src/index.ts src/vertical.ts src/horizontal.ts src/is-element-on-screen.ts src/measure.ts --bundle --sourcemap --target=es2018 --outdir=dist --format=esm && esbuild src/index.ts src/vertical.ts src/horizontal.ts src/is-element-on-screen.ts src/measure.ts --bundle --sourcemap --target=es2018 --outdir=dist --format=cjs --out-extension:.js=.bundle.cjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:package": "publint",
    "check:biome": "biome check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "test:consumers": "node scripts/test-consumers.mjs",
    "test:browser": "npm run build && playwright test",
    "example": "npm run build && node scripts/serve-example.mjs",
    "check": "npm run check:biome && npm run typecheck && npm run test:coverage && npm run build && npm run lint:package && npm run test:package && npm run test:consumers",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "viewable",
    "viewability",
    "advertising",
    "advertisement",
    "screen",
    "element"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/viewability.git"
  },
  "bugs": {
    "url": "https://github.com/kahwee/viewability/issues"
  },
  "homepage": "https://github.com/kahwee/viewability",
  "author": "KahWee Teng <tengkahwee@gmail.com> (https://kw.sg/)",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "publint": "^0.3.24",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
